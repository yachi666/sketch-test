{
  "name": "@sketch-test/control-plane",
  "version": "0.0.0",
  "private": true,
  "description": "SketchTest Control Plane \u2014 production Fastify API server",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc --noEmit false --allowImportingTsExtensions false --incremental false",
    "dev": "tsx --watch src/main.ts",
    "start": "node dist/main.js",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "test": "vitest run --exclude '**/dist/**'",
    "clean": "rm -rf dist/ tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@fastify/cors": "^11.3.1",
    "@sketch-test/adapter-arazzo": "workspace:*",
    "@sketch-test/adapter-openapi": "workspace:*",
    "@sketch-test/adapter-postman": "workspace:*",
    "@sketch-test/canonical-api-model": "workspace:*",
    "@sketch-test/runner-protocol": "workspace:*",
    "@sketch-test/test-dsl": "workspace:*",
    "@sketch-test/workflow-dsl": "workspace:*",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "catalog:",
    "@sketch-test/generation-protocol": "workspace:*",
    "@sketch-test/adapter-code-discovery": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
