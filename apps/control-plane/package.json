{
  "name": "@sketch-test/control-plane",
  "version": "0.0.0",
  "private": true,
  "description": "SketchTest Control Plane — production Fastify API server",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc --noEmit false --allowImportingTsExtensions false --incremental false",
    "dev": "tsx --watch src/main.ts",
    "start": "node dist/main.js",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "test": "vitest run",
    "clean": "rm -rf dist/ tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@fastify/cors": "^11.3.0",
    "@sketch-test/adapter-openapi": "workspace:*",
    "@sketch-test/canonical-api-model": "workspace:*",
    "@sketch-test/contracts-common": "workspace:*",
    "@sketch-test/runner-protocol": "workspace:*",
    "@sketch-test/test-dsl": "workspace:*",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
