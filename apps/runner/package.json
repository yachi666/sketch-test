{
  "name": "@sketch-test/runner",
  "version": "0.0.0",
  "private": true,
  "description": "SketchTest Runner — executes HTTP tests in isolated process",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --noEmit false --allowImportingTsExtensions false --incremental false",
    "dev": "tsx --watch src/index.ts",
    "dev:daemon": "tsx --watch src/daemon.ts",
    "start": "node dist/daemon.js",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "test": "vitest run",
    "clean": "rm -rf dist/ tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@sketch-test/contracts-common": "workspace:*",
    "@sketch-test/canonical-api-model": "workspace:*",
    "@sketch-test/test-dsl": "workspace:*",
    "@sketch-test/runner-protocol": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
