{
  "name": "@sketch-test/runner",
  "version": "0.0.0",
  "private": true,
  "description": "SketchTest Runner \u2014 executes HTTP tests in isolated process",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --noEmit false --allowImportingTsExtensions false --incremental false",
    "dev": "tsx --watch src/index.ts",
    "dev:daemon": "tsx --watch src/daemon.ts",
    "start": "node dist/daemon.js",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "test": "vitest run --exclude '**/dist/**'",
    "clean": "rm -rf dist/ tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "@sketch-test/contracts-common": "workspace:*",
    "@sketch-test/runner-protocol": "workspace:*"
  },
  "devDependencies": {
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
