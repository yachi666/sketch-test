{
  "name": "@sketch-test/adapter-raml",
  "version": "0.1.0",
  "private": true,
  "description": "RAML 1.0 adapter — produces CanonicalApiModel",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit false --allowImportingTsExtensions false --incremental false",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "test": "vitest run --exclude '**/dist/**'",
    "clean": "rm -rf dist/ tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@sketch-test/canonical-api-model": "workspace:*",
    "@sketch-test/contracts-common": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@sketch-test/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
