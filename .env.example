# SketchTest local-development configuration. Never commit real credentials.
NODE_ENV=development

# Control Plane
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sketchtest
CP_HOST=0.0.0.0
CP_PORT=3802
LOG_LEVEL=info
WEB_ORIGINS=http://127.0.0.1:5173
JWT_SECRET=replace-with-at-least-32-random-characters
SECRET_KEY=replace-with-at-least-32-random-characters
RUNNER_REGISTRATION_TOKEN=replace-with-at-least-32-random-characters

# Web
VITE_CP_BASE=http://localhost:3802

# Runner. In production RUNNER_TOKEN and RUNNER_ID are both mandatory.
CP_URL=http://localhost:3802
WORKSPACE_ID=ws_default
RUNNER_NAME=runner-local
RUNNER_VERSION=0.1.0
RUNNER_LABELS=local
# RUNNER_ID=rnr_provisioned
# RUNNER_TOKEN=sk-provisioned-token

# Object storage (required in production once the storage slice is enabled)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace-me
S3_BUCKET=sketchtest-artifacts
