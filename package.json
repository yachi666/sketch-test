{
  "name": "sketch-test",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SketchTest — REST API 自动化测试平台",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=12.10.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:cp": "pnpm --filter control-plane dev",
    "dev:runner": "pnpm --filter runner dev",
    "dev:fixture": "pnpm --filter hermetic-fixture-server dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter web build",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e:product": "node apps/control-plane/scripts/product-e2e.mjs",
    "e2e:compose": "node apps/control-plane/scripts/compose-smoke.mjs",
    "clean": "turbo run clean && node scripts/clean-cache.mjs",
    "clean:cache": "node scripts/clean-cache.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:biome": "biome check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
